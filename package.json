{
  "name": "fetch-swedish-word-compounds",
  "version": "1.0.0",
  "description": "A small API server for analysing a given Swedish word by scraping online dictionaries.",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "deploy:built": "npm run deploy -- --prebuilt --mode production && npm run smoke",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthow4n/fetch-swedish-word-compounds.git"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.1",
    "@cloudflare/vitest-plugin": "1.8.4",
    "cf": "1.0.0-rc.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "dependencies": {
    "css-select": "7.0.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0"
  }
}
